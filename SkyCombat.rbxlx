          <string name="Source"><![CDATA[local Events = {
	-- List of RemoteEvent names to be created/used
	ACTIVATE_JETPACK = "ActivateJetpack",
	CLASS_SELECTED = "ClassSelected",
	MATCH_STARTED = "MatchStarted",
	UPDATE_FUEL = "UpdateFuel"
